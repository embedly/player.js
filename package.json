{
  "name": "player.js",
  "version": "0.1.0",
  "description": "Control embedded video and audio across multiple providers",
  "homepage": "https://github.com/embedly/player.js",
  "license": "BSD-3-Clause",
  "author": {
    "name": "Embedly"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embedly/player.js.git"
  },
  "files": [
    "dist",
    "!dist/player-0.1.0.js",
    "!dist/player-0.1.0.min.js"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/player.min.js",
  "jsdelivr": "./dist/player.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "npm run build && vp test && playwright test",
    "test:unit": "vp test",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "release:cdn": "npm run build && node scripts/release-cdn.ts",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "warn"
    }
  },
  "title": "Player.js"
}
